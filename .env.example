# Chep thanh .env roi sua. File .env khong duoc commit.

# that = nap model that; gia = model gia cho test, khong can GPU
ASR_BACKEND=that

# Adapter LoRA (co san trong repo). De trong thi mac dinh V2 (ban chot theo quy tac DEV, xem configs/ban_chot.json);
# checkpoints/V3/best, V4/best de so sanh; none de chay VinAI goc (B0).
ADAPTER_PATH=checkpoints/V2/best

# Khoa API: dat mot chuoi ngau nhien khi deploy public; app tu gui kem header X-API-Key
API_KEY=

# Gioi han kich thuoc file tai len, MB
MAX_UPLOAD_MB=50

# Cong
API_PORT=8000
APP_PORT=7860

# Dat 1 de Gradio tao link public tam thoi
GRADIO_SHARE=0

# Cache trong so Hugging Face
HF_HOME=/models
